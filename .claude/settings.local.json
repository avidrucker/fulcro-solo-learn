{
  "permissions": {
    "allow": [
      "Bash(clj-nrepl-eval *)",
      "Bash(where shadow-cljs *)",
      "Bash(where npx *)",
      "Bash(npm --version)",
      "Bash(npm install *)",
      "Bash(npx shadow-cljs *)",
      "Bash(git check-ignore *)",
      "Bash(npm run *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\notify.wav').PlaySync()",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\notify.wav').PlaySync()",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
