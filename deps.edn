{:paths ["src"]
 :deps  {com.fulcrologic/fulcro      {:mvn/version "3.9.5"}
         com.fulcrologic/statecharts {:mvn/version "1.3.0"}
         com.wsscode/pathom          {:mvn/version "2.4.0"}
         com.taoensso/timbre         {:mvn/version "6.8.0"}
         metosin/malli               {:mvn/version "0.16.4"}
         com.fulcrologic/guardrails  {:mvn/version "1.2.16"}}
 :aliases
 {:nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts  ["-m" "nrepl.cmdline"
                       "--port" "7888"
                       "--port-file" ".nrepl-port"]}
  :test  {:extra-paths ["test"]
          :extra-deps  {fulcrologic/fulcro-spec {:mvn/version "3.2.8"}}
          :jvm-opts    ["-Dguardrails.enabled=true"]}
  ;; Browser/CLJS build (Phase 6). shadow-cljs reads this alias from
  ;; shadow-cljs.edn (`:deps {:aliases [:cljs]}`) so JS-side classpath
  ;; matches the JVM-side. ClojureScript itself is pulled transitively
  ;; via Fulcro; pin it here only if a specific version is needed.
  :cljs  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.16"}}}}}
